# OpenAI-compatible provider. DeepSeek only needs base URL/model changes.
WRITING_AGENT_LLM_PROVIDER=openai
WRITING_AGENT_OPENAI_BASE_URL=https://api.deepseek.com
WRITING_AGENT_OPENAI_API_KEY=
WRITING_AGENT_OPENAI_MODEL=deepseek-v4-flash
WRITING_AGENT_OPENAI_TIMEOUT_S=60

# Use Ollama only when explicitly selected.
# WRITING_AGENT_LLM_PROVIDER=ollama
# WRITING_AGENT_USE_OLLAMA=1
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

WRITING_AGENT_DATA_DIR=.data
WRITING_AGENT_PERSIST_DIAGNOSTICS=0
WRITING_AGENT_PERSIST_PHASE_METRICS=0
WRITING_AGENT_PERSIST_TEXT_BLOCKS=0
WRITING_AGENT_RAG_AUDIT_ENABLED=0

# Optional: empty means vector embeddings are disabled.
WRITING_AGENT_EMBED_MODEL=

WRITING_AGENT_WORKERS=4
WRITING_AGENT_SECTION_TIMEOUT_S=60
WRITING_AGENT_STREAM_MAX_S=180
WRITING_AGENT_EDIT_PLAN_ENABLE=1
WRITING_AGENT_EDIT_PLAN_TIMEOUT_S=20
WRITING_AGENT_EDIT_REQUIRE_CONFIRM_HIGH=1
